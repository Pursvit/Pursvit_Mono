{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "generateOptions": {
    "spec": false
  },
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": ".swcrc",
        "extensions": [".ts", ".tsx", ".js", ".jsx"]
      }
    },
    "typeCheck": true,
    "deleteOutDir": true
  }
}
